    {
      "name": "Check Cart is Empty After Removal",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response time is less than 500ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(500);",
              "});",
              "",
              "const response = pm.response.json();",
              "",
              "pm.test(\"item_count is 0 and items array is empty\", function () {",
              "    pm.expect(response.item_count).to.be.a('number').and.to.equal(0);",
              "    pm.expect(response.items).to.be.an('array').and.to.have.length(0);",
              "    pm.expect(response.items.length).to.equal(response.item_count);",
              "});",
              "",
              "pm.test(\"Content-Type is either application/json or text/javascript\", function () {",
              "    const contentType = pm.response.headers.get(\"Content-Type\");",
              "    pm.expect(contentType).to.be.oneOf([",
              "        \"application/json\",",
              "        \"application/json; charset=utf-8\",",
              "        \"text/javascript\",",
              "        \"text/javascript; charset=utf-8\"",
              "    ]);",
              "});",
              "",
              "pm.test(\"Response has correct top-level fields\", function () {",
              "    const expectedKeys = [",
              "        \"token\", \"note\", \"attributes\", \"original_total_price\", \"total_price\",",
              "        \"total_discount\", \"total_weight\", \"item_count\", \"items\", \"requires_shipping\",",
              "        \"currency\", \"items_subtotal_price\", \"cart_level_discount_applications\", \"discount_codes\"",
              "    ];",
              "    expectedKeys.forEach(key => {",
              "        pm.expect(response).to.have.property(key);",
              "    });",
              "});",
              "",
              "pm.test(\"Data types are correct\", function () {",
              "    pm.expect(response.token).to.be.a('string');",
              "    pm.expect(response.note).to.be.a('string');",
              "    pm.expect(response.attributes).to.be.an('object');",
              "    pm.expect(response.original_total_price).to.be.a('number');",
              "    pm.expect(response.total_price).to.be.a('number');",
              "    pm.expect(response.total_discount).to.be.a('number');",
              "    pm.expect(response.total_weight).to.be.a('number');",
              "    pm.expect(response.item_count).to.be.a('number');",
              "    pm.expect(response.items).to.be.an('array');",
              "    pm.expect(response.requires_shipping).to.be.a('boolean');",
              "    pm.expect(response.currency).to.be.a('string');",
              "    pm.expect(response.items_subtotal_price).to.be.a('number');",
              "    pm.expect(response.cart_level_discount_applications).to.be.an('array');",
              "    pm.expect(response.discount_codes).to.be.an('array');",
              "});",
              "",
              "pm.test(\"Currency is USD\", function () {",
              "    pm.expect(response.currency).to.eql(\"USD\");",
              "});",
              "",
              "pm.test(\"Total price, original total price, and discount are zero\", function () {",
              "    pm.expect(response.total_price).to.eql(0);",
              "    pm.expect(response.original_total_price).to.eql(0);",
              "    pm.expect(response.total_discount).to.eql(0);",
              "    pm.expect(response.items_subtotal_price).to.eql(0);",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
