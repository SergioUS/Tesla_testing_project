              "pm.environment.set(\"QTY\", jsonData.items[0].quantity);",
              "pm.environment.set(\"id\", jsonData.items[0].id);",
              "pm.environment.set(\"key\", jsonData.items[0].key);",
              "pm.environment.set(\"title\", jsonData.items[0].title);",
              "pm.environment.set(\"price\", jsonData.items[0].price);",
              "pm.environment.set(\"original_price\", jsonData.items[0].original_price);",
              "pm.environment.set(\"presentment_price\", jsonData.items[0].presentment_price);",
              "pm.environment.set(\"sku\", jsonData.items[0].sku);",
              "pm.environment.set(\"Currency\", jsonData.currency);",
              "",
              "pm.test(\"Cart contains exactly 1 item\", function () {",
              "    pm.expect(jsonData.item_count).to.equal(1);",
              "    pm.expect(jsonData.items).to.have.length(1);",
